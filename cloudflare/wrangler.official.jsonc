{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "termbridge-cloud",
  "main": "./worker.js",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "TB_PUBLIC_ROOMS": "1"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY",
        "class_name": "TermbridgeRelay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TermbridgeRelay"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
