# TermBridge local environment overrides (copy to `.env` or `~/.termbridge/.env`, chmod 600).
# Both `.env` and `.env.local` are gitignored and NEVER committed to the repository.
# Precedence: shell env > ./.env.local > ./.env > ~/.termbridge/.env

# Optional: custom multi-room Cloudflare Worker relay (used by `tb cloudflare pair` / `tb1_` codes)
# TB_CLOUDFLARE_RELAY=wss://<your-worker>.<your-subdomain>.workers.dev

# Optional: override Host display name or default target Host
# HOST_NAME=my-mac
# TB_HOST=

# Optional: Herdr integration (`off` disables discovery; or set a custom socket path)
# TB_HERDR=
# TB_HERDR_SOCKET=

# Optional: read-only workspace root for Global Brain `workspace_files` tool (default: ~/code)
# TB_BRAIN_FILES_ROOT=~/code

# Optional: Global Brain & cloud voice credentials (BYOK; keep strictly local, never commit)
# DASHSCOPE_API_KEY=
# TB_BRAIN_MODEL=deepseek-v4.1-flash
# TB_VOICE_PROVIDER=auto
# VOLCENGINE_S2S_API_KEY=

# Set to 1 to disable automatic `.env` loading
# TB_NO_DOTENV=0
