{
  "manifest_version": 3,
  "name": "TermBridge",
  "version": "0.1.0",
  "description": "在你允许时，让 TermBridge Agent 读取和操作 Chrome 网页。",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon.png"
  }
}
