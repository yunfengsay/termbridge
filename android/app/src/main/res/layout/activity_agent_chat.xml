<?xml version="1.0" encoding="utf-8"?>
<!--
  The chat view of a session. Everything below the transcript is the same
  composer the terminal uses, so switching views does not change how typing,
  pasting an image or attaching one behaves.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <TextView
        android:id="@+id/chatStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:text="@string/connecting"
        android:textColor="@color/ink_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/surfaceContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/recovery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/copyPending"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/agent_chat_copy_unconfirmed"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retry"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/agent_chat_retry"
            android:visibility="gone" />
    </LinearLayout>

    <include
        android:id="@+id/chatKeys"
        layout="@layout/view_chat_keys"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/composer"
        layout="@layout/view_composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
