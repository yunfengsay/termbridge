<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/line"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/phoneActionPolicyName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/phoneActionPolicyChoices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/phoneActionPolicyAlways"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/phone_action_policy_always_short"
                android:textColor="@color/ink"
                android:textSize="11sp" />

            <RadioButton
                android:id="@+id/phoneActionPolicyConversation"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/phone_action_policy_conversation_short"
                android:textColor="@color/ink"
                android:textSize="11sp" />

            <RadioButton
                android:id="@+id/phoneActionPolicyAllow"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/phone_action_policy_allow_short"
                android:textColor="@color/ink"
                android:textSize="11sp" />

            <RadioButton
                android:id="@+id/phoneActionPolicyDeny"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/phone_action_policy_deny_short"
                android:textColor="@color/ink"
                android:textSize="11sp" />
        </RadioGroup>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
