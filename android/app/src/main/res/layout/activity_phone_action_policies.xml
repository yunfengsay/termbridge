<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/phoneActionPolicyRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/phoneActionPolicyToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/paper"
        android:title="@string/phone_action_policy_title"
        app:navigationIcon="@drawable/ic_arrow_back"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        app:navigationIconTint="@color/ink"
        app:titleTextColor="@color/ink" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/phone_action_policy_detail"
                android:textColor="@color/ink_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/phoneActionPolicyList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/revokeConversationApprovalsButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:text="@string/phone_action_revoke_conversation"
                android:textAllCaps="false" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
