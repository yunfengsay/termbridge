<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/navigatorRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/review_navigator_row_background"
    android:gravity="center_vertical"
    android:minHeight="32dp"
    android:orientation="horizontal"
    android:paddingTop="1dp"
    android:paddingBottom="1dp">

    <TextView
        android:id="@+id/navigatorGlyph"
        android:layout_width="14dp"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:gravity="center"
        android:textSize="10sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/navigatorIcon"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:layout_marginStart="2dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/navigatorTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:textColor="@color/ink"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/navigatorStats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:textColor="@color/ink_muted"
        android:textSize="9sp" />
</LinearLayout>
