<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="4dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/scanPairing"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/scan_pairing_qr"
        app:icon="@drawable/ic_qr_code"
        app:iconGravity="textStart" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" android:hint="@string/connection_name">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/connectionName"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/connectionMode"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
        app:singleSelection="true" app:selectionRequired="true">
        <com.google.android.material.button.MaterialButton android:id="@+id/directMode"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:minHeight="48dp" android:textAllCaps="false" android:text="@string/lan_direct" />
        <com.google.android.material.button.MaterialButton android:id="@+id/relayMode"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:minHeight="48dp" android:textAllCaps="false" android:text="@string/connection_server" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/lan_connection_hint" android:textColor="@color/ink_muted" android:textSize="13sp" />


    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/relayLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/relay_url">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/relayUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/relay_hint"
            android:inputType="textUri"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout android:id="@+id/portLayout"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/lan_port">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/port"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLines="1" android:text="7400" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:id="@+id/hostLayout"
        android:hint="@string/host_id"
        app:helperText="@string/host_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/hostId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:id="@+id/passwordLayout"
        android:hint="@string/shared_secret"
        app:endIconMode="password_toggle"
        app:helperText="@string/shared_secret_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/sharedSecret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/lanUseTls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/lan_legacy_tls"
        android:checked="false" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:id="@+id/fingerprintLayout"
        android:hint="@string/tls_fingerprint"
        app:helperText="@string/tls_fingerprint_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/tlsFingerprint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:inputType="text"
            android:maxLines="2" />
    </com.google.android.material.textfield.TextInputLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/session_ui_summary"
        android:textColor="@color/ink_muted"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sessionUi"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/session_ui_setting" />

    <TextView
        android:id="@+id/backgroundAccessStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/background_access_restricted"
        android:textColor="@color/ink_muted"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/backgroundAccess"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/background_access_allow" />

    <TextView
        android:id="@+id/watchSettingsSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/watch_settings_summary"
        android:textColor="@color/ink_muted"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/watchSettings"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/watch_settings"
        app:icon="@drawable/ic_termbridge_watch"
        app:iconGravity="textStart"
        app:iconSize="20dp" />

</LinearLayout>
