<?xml version="1.0" encoding="utf-8"?>
<!--
  The one composer both session views use.

  The chat view is another way to look at the same session, so its input must be
  the same input: same Material field, same IME options, same image paste target
  and the same attach/upload affordance. Keeping one layout is what stops the two
  views from drifting into two different text boxes.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/composerBarBackground"
    android:orientation="vertical">

<TextView
    android:id="@+id/composerAttachmentStatus"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="14dp"
    android:paddingTop="2dp"
    android:paddingEnd="14dp"
    android:paddingBottom="4dp"
    android:textColor="?attr/composerStatusText"
    android:textSize="12sp"
    android:visibility="gone" />

<LinearLayout
    android:id="@+id/composerBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="bottom"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="4dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <ImageButton
        android:id="@+id/composerAttach"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/attach_image"
        android:padding="12dp"
        android:src="@drawable/ic_attach"
        app:tint="?attr/composerIconTint" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/composerLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
            app:boxBackgroundColor="?attr/composerFieldBackground"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="?attr/composerFieldStroke"
        app:hintTextColor="?attr/composerHintText">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/composerInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:imeOptions="actionSend|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="48dp"
            android:paddingTop="12dp"
            android:paddingBottom="10dp"
            android:textColor="?attr/composerText"
            android:textColorHint="?attr/composerHintText"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <ImageButton
        android:id="@+id/composerSend"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/composer_send_background"
        android:contentDescription="@string/send_message"
        android:padding="12dp"
        android:src="@drawable/ic_send"
        app:tint="?attr/composerSendTint" />
</LinearLayout>
</LinearLayout>
