<Window x:Class="TermBridge.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:TermBridge.App" xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives" Title="TermBridge">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel x:Name="TitleArea" Orientation="Horizontal" Spacing="8" Padding="12,0" VerticalAlignment="Stretch"><Image Source="Assets/logo.png" Width="20" Height="20"/><TextBlock Text="TermBridge" FontSize="12" VerticalAlignment="Center"/></StackPanel>
  <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="LeftCompact" OpenPaneLength="208" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="True" SelectionChanged="NavigationChanged" Header="">
   <NavigationView.MenuItems><NavigationViewItemHeader Content="你的电脑"/><NavigationViewItem x:Name="AddComputer" Content="添加电脑" Tag="add" Icon="Add"/></NavigationView.MenuItems>
   <NavigationView.PaneFooter><StackPanel x:Name="HostFooter" Padding="20,12" Spacing="8"><TextBlock Text="这台 Windows 电脑" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="TermBridge 0.2.2" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></NavigationView.PaneFooter>
   <Grid Padding="4,0,0,0" RowSpacing="0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <InfoBar x:Name="ErrorBar" Grid.Row="0" IsOpen="False" IsClosable="True" Severity="Error"/>
    <Grid x:Name="Workspace" Grid.Row="1" ColumnSpacing="0"><Grid.ColumnDefinitions><ColumnDefinition x:Name="SessionColumn" Width="216"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid RowSpacing="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Margin="8,4,8,0"><TextBlock x:Name="PageTitle" Text="连接你的电脑" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="ConnectionStatus" Text="添加电脑以继续对话" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
      <AutoSuggestBox x:Name="Search" Grid.Row="1" Margin="4,0" PlaceholderText="搜索会话" QueryIcon="Find" TextChanged="SearchChanged"/>
<ListView x:Name="SessionList" Grid.Row="2" Padding="0,0,0,52" IsItemClickEnabled="True" ItemClick="SessionClicked" SelectionChanged="SessionChanged" SelectionMode="Single">
      <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="8,4"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
      <ListView.ItemTemplate><DataTemplate><Grid RowSpacing="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" Grid.ColumnSpan="2"/><TextBlock Grid.Row="1" Text="{Binding Detail}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Row="1" Grid.Column="1" Margin="6,0,0,0" Text="{Binding Status}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid></DataTemplate></ListView.ItemTemplate>
     <ListView.Footer><Border Height="48"/></ListView.Footer></ListView>
      <Border Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="8" Padding="3" CornerRadius="18" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Orientation="Horizontal" Spacing="2">
       <Button x:Name="NewButton" Width="32" Height="32" Padding="0" CornerRadius="16" Style="{StaticResource AccentButtonStyle}" Click="NewClicked" IsEnabled="False" AutomationProperties.Name="新建对话" ToolTipService.ToolTip="新建对话"><FontIcon Glyph="&#xE710;" FontSize="14"/></Button>
       <Button x:Name="RefreshButton" Width="32" Height="32" Padding="0" CornerRadius="16" Click="RefreshClicked" AutomationProperties.Name="刷新会话" ToolTipService.ToolTip="刷新会话"><FontIcon Glyph="&#xE72C;" FontSize="14"/></Button>
      </StackPanel></Border>
     </Grid>
     <local:PaneDivider x:Name="SessionDivider" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsTabStop="True" PointerPressed="DividerPointerPressed" KeyDown="DividerKeyDown" AutomationProperties.Name="调整会话列表宽度" ToolTipService.ToolTip="拖动调整宽度 · 方向键微调"><Grid Background="Transparent"><Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/></Grid></local:PaneDivider>
     <Border Grid.Column="2" CornerRadius="0" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><Grid RowSpacing="0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <!-- Two views of the SAME agent session. Switching never restarts it, and the choice is local to this computer. -->
      <Grid x:Name="ViewBar" Grid.Row="0" Padding="8,6" ColumnSpacing="8" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel Orientation="Horizontal" Spacing="4"><primitives:ToggleButton x:Name="ChatViewItem" Content="对话" MinWidth="64" Padding="10,3" Click="ViewChanged" AutomationProperties.Name="对话视图"/><primitives:ToggleButton x:Name="TerminalViewItem" Content="终端" MinWidth="64" Padding="10,3" Click="ViewChanged" AutomationProperties.Name="终端视图"/></StackPanel>
       <TextBlock x:Name="ChatStatus" Grid.Column="1" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </Grid>
      <Grid Grid.Row="1">
       <WebView2 x:Name="TerminalView" AutomationProperties.Name="终端输入" Visibility="Collapsed"/>
       <WebView2 x:Name="ChatView" AutomationProperties.Name="对话记录" Visibility="Collapsed"/>
       <StackPanel x:Name="TerminalEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="20"><FontIcon Glyph="&#xE756;" FontSize="40"/><TextBlock Text="继续你的对话" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="从左侧选择会话，或开始新的对话。" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
      </Grid>
      <!-- The composer stays native so IME composition, Shift+Enter and paste behave like the rest of Windows. -->
      <Grid x:Name="Composer" Grid.Row="2" Padding="8" RowSpacing="4" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBox x:Name="ComposerBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="160" PlaceholderText="输入消息，Enter 发送，Shift+Enter 换行" AutomationProperties.Name="给 Agent 的消息" PreviewKeyDown="ComposerKeyDown" TextChanged="ComposerTextChanged"/>
       <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom" Spacing="4">
        <Button x:Name="ComposerSend" Content="发送" Style="{StaticResource AccentButtonStyle}" MinWidth="72" Click="ComposerSendClicked" IsEnabled="False"/>
        <Button x:Name="ComposerRetry" Content="重试" MinWidth="72" Click="ComposerRetryClicked" Visibility="Collapsed"/>
       </StackPanel>
       <TextBlock x:Name="ComposerHint" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,2,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </Grid>
     </Grid></Border>
    </Grid>
    <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Padding="12" Visibility="Collapsed"><StackPanel Spacing="12" MaxWidth="760" HorizontalAlignment="Stretch">
     <TextBlock Text="设置" FontWeight="SemiBold" FontSize="18"/>
     <Border Padding="12" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="8"><TextBlock x:Name="AssistanceTitle" Text="本机协助已关闭" FontWeight="SemiBold"/><TextBlock x:Name="AssistanceDescription" Text="允许后，Agent 可查看屏幕并操作这台 Windows 电脑。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Button x:Name="AssistanceButton" Content="允许协助" IsEnabled="False" Click="AssistanceClicked"/></StackPanel></Border>
     <Border Padding="12" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="8"><TextBlock Text="Chrome 插件" FontWeight="SemiBold"/><TextBlock x:Name="BrowserStatus" Text="正在检测 Chrome 连接…" FontSize="12" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="6"><Button Content="安装连接组件" Click="InstallBrowserClicked"/><Button Content="打开插件目录" Click="BrowserFolderClicked"/><Button Content="检测连接" Click="CheckBrowserClicked"/></StackPanel><Button Content="打开 Chrome 扩展管理" Click="OpenChromeExtensionsClicked"/><TextBlock Text="插件尚未上架商店：打开扩展管理，开启开发者模式，加载插件目录。然后在插件中开启浏览器协助。" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border>
     <TextBlock Text="个性化" FontWeight="SemiBold"/><Border Padding="12" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock Text="外观"/><TextBlock Text="使用 Windows 原生主题和控件" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><ComboBox x:Name="ThemePicker" Grid.Column="1" SelectionChanged="ThemeChanged" SelectedIndex="0"><ComboBoxItem Content="跟随 Windows"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/></ComboBox></Grid></Border>
     <Border Padding="12" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="8"><TextBlock Text="默认会话界面"/><ComboBox x:Name="SessionViewPicker" SelectionChanged="SessionViewChanged" SelectedIndex="0" HorizontalAlignment="Stretch" AutomationProperties.Name="默认会话界面"><ComboBoxItem Content="自动" Tag="auto"/><ComboBoxItem Content="对话优先" Tag="chat"/><ComboBoxItem Content="终端" Tag="terminal"/></ComboBox><TextBlock Text="自动选择会话支持的界面。对话优先在不支持时说明原因并打开终端。设置用于之后打开的会话，当前会话仍可随时切换。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border>
     <TextBlock Text="连接与工具" FontWeight="SemiBold" Margin="0,12,0,0"/><Border Padding="12" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="12"><TextBlock Text="网络代理"/><TextBox x:Name="ProxyBox" PlaceholderText="HTTP 代理地址，留空直连"/><Button Content="保存并重连" Click="SaveProxyClicked"/></StackPanel></Border>
     <Border Padding="12" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="10"><TextBlock Text="TB 命令行"/><TextBlock x:Name="CliStatus" Text="正在检测" FontSize="12"/><TextBlock Text="随 App 安装，与 App 共用加密配对配置。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Button Content="重新检测" Click="CheckCliClicked"/></StackPanel></Border>
     <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="添加电脑" Click="AddClicked"/><Button Content="忘记当前电脑" Click="ForgetClicked"/></StackPanel>
    </StackPanel></ScrollViewer>

   </Grid>
  </NavigationView>
 </Grid>
</Window>
